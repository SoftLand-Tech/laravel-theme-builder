{
    "name": "softlandtech/theme-builder",
    "description": "A general-purpose Laravel + React visual theme builder and storefront/site block renderer — ecommerce, LMS, CMS, or personal sites. No Filament, no Spatie, no domain-model coupling.",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "theme", "builder", "storefront", "react", "ecommerce", "lms", "cms", "page-builder"],
    "require": {
        "php": "^8.3",
        "laravel/framework": "^13.0"
    },
    "require-dev": {
        "laravel/pint": "^1.30",
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "SoftLand\\ThemeBuilder\\": "src/"
        },
        "files": [
            "src/Support/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "SoftLand\\ThemeBuilder\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "SoftLand\\ThemeBuilder\\ThemeBuilderServiceProvider"
            ],
            "aliases": {
                "ThemeBuilder": "SoftLand\\ThemeBuilder\\Facades\\ThemeBuilder"
            }
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "test": "pest",
        "lint": "pint --test",
        "format": "pint"
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
