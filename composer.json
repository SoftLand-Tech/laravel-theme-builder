{
    "name": "softlandtech/theme-builder",
    "description": "A framework-agnostic-ish Laravel + React visual theme builder and storefront block renderer. No Filament, no Spatie, no domain-model coupling.",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "theme", "builder", "storefront", "react", "ecommerce", "page-builder"],
    "require": {
        "php": "^8.3",
        "laravel/framework": "^13.0"
    },
    "require-dev": {
        "pestphp/pest": "^3.0",
        "orchestra/testbench": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "SoftLand\\ThemeBuilder\\": "src/"
        },
        "files": [
            "src/Support/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "SoftLand\\ThemeBuilder\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "SoftLand\\ThemeBuilder\\ThemeBuilderServiceProvider"
            ],
            "aliases": {
                "ThemeBuilder": "SoftLand\\ThemeBuilder\\Facades\\ThemeBuilder"
            }
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
