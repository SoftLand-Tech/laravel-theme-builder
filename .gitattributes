# Ignore dev/test/doc files in Composer dist archives.
/.github export-ignore
/tests export-ignore
/CHANGELOG.md export-ignore
/SECURITY.md export-ignore
/phpunit.xml.dist export-ignore
/.gitattributes export-ignore
/.gitignore export-ignore

# Line endings.
* text=auto
*.php text eol=lf
*.md text eol=lf
*.json text eol=lf
*.blade.php text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.css text eol=lf
